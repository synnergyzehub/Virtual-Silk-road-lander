modules = ["python-3.11", "postgresql-16", "python3"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "streamlit run app.py --server.port 8080"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Streamlit New App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Voi Jeans Inventory"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Simple Test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Simple Test 8501"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Minimal Voi"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EmpireOS Onboarding"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Super Minimal 5000"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Welcome Page Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Subscription Demo"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Subscription Demo Python"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Minimal Voi 8501"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Genesis Dashboard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "License API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "License Management"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Genesis Shell"

[[workflows.workflow]]
name = "Streamlit New App"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run new_app.py --server.port 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "Voi Jeans Inventory"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run voi_inventory_management.py --server.port 5000"
waitForPort = 5000

